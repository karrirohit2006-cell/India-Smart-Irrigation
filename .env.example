# ========================================================
# AI Smart Irrigation Planner - Environment Configuration
# ========================================================

# Flask Environment (development | production)
FLASK_ENV=development

# Application Secret Key (auto-generated in production on Render)
FLASK_SECRET_KEY=your_secret_key_here

# Google Gemini API Key (Required for AgriSaathi AI Agricultural Chatbot)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default: 5000)
PORT=5000

# WebAuthn / Passkey Configuration (Optional for custom domains in production)
# In production on Render:
# WEBAUTHN_RP_ID=your-service-name.onrender.com
# WEBAUTHN_ORIGIN=https://your-service-name.onrender.com
# In local development:
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:5000
